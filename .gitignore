# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# --- 仮想環境 ---
.venv/
venv/
env/

# --- Node / Vite ---
node_modules/
.vite/
.eslintcache
*.tsbuildinfo

# --- Build outputs ---
dist/
dist-ssr/
*.local

# --- 環境変数（.env.example はトラッキング、実値は除外） ---
.env
.env.local
.env.*.local

# --- ランタイムデータ ---
# SQLite に保存されるユーザー定義構成は実行時データ扱い（リポジトリには含めない）
apps/agents/data/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.swp
*.swo

# --- Claude Code ---
# allowlist 方式: .claude/ は基本除外、settings.json だけ共有設定としてトラッキング。
# こうしておくと Claude Code が将来追加するキャッシュ・セッションログ・個人設定等が
# 自動的に除外され、誤って秘密情報を commit するリスクが減る
.claude/*
!.claude/settings.json

# --- 開発者個人の作業ファイル（公開リポジトリには含めない） ---
# RESUME.md: セッション再開ガイド（個人メモ用途、内部の作業状態を含む）
# meeting/: ミーティング資料の作業フォルダ（app_overview.html / Q&A 集 等）
RESUME.md
meeting/

# --- 内部資料（社内のみで共有、公開リポジトリには含めない） ---
# preset/ の .pptx は社員向け / 構築提案資料
# reports/ の進捗レポートは経営判断材料を含む
docs/preset/
docs/reports/
