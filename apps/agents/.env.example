# データベース — 未設定ならローカル開発用の SQLite (apps/agents/data/results.sqlite3)。
# ホスティング時は PostgreSQL の接続文字列を設定すると psycopg3 経由で Postgres を使う。
# 例 (Supabase): postgresql://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# コネクションプールの最大接続数 (既定 10)。Supabase pooler 使用時は上限に注意。
# DB_POOL_MAX=10

# ログの保存先 — 未設定ならローカル FS (samples/logs/)。ホスティング時は GCS を指定。
# gs://<bucket>/<prefix> 形式。認証は ADC (Cloud Run のサービスアカウント)。
# LOG_STORE=gs://your-bucket/logs

# コードベースの保存先 — 未設定ならローカル FS (samples/source/)。GCS を指定すると
# 解析前にローカルへ展開し、取り込み結果を書き戻す（処理は必ずローカル実 FS）。
# SOURCE_STORE=gs://your-bucket/source

# 公開ゲート（ホスティング時のみ設定。未設定＝ローカル現状維持）
# API 認証キー。設定すると全 API に X-API-Key を必須化（/health は除外）。
# API_KEY=change-me
# CORS 許可オリジン（カンマ区切り、例: https://your-app.vercel.app）
# CORS_EXTRA_ORIGINS=https://your-app.vercel.app
# 本番は 0 にして localhost を CORS 許可から外す（既定 1＝dev 用に localhost 許可）。
# CORS_ALLOW_LOCALHOST=0
# 解析(POST /api/runs*)の 1 分あたり上限。0＝無効。鍵漏洩時のコスト暴走対策。
# RATELIMIT_RUNS_PER_MIN=10

# Anthropic — used by config1 baseline agent and config2/3/4 analyses
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
BASELINE_MODEL=claude-sonnet-4-5
FILTER_MODEL=claude-haiku-4-5

# OpenAI — used by config3 multi-model (3rd model: GPT-4o)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Langfuse — set after creating an org/project in the Langfuse UI
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx
LANGFUSE_HOST=http://localhost:3000

# BigQuery — 大容量ログの取得ルート (config-log 解析でノード単位に選択)
# サービスアカウント JSON キーのパス
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
BIGQUERY_PROJECT=your-gcp-project-id
BIGQUERY_DATASET=network_logs
BIGQUERY_LOGS_TABLE=device_logs
# データセット/ジョブのロケーション (東京)。US マルチリージョンを避ける
BIGQUERY_LOCATION=asia-northeast1
# 1 クエリのスキャン上限 (バイト)。コスト暴発防止。既定 1GB
BIGQUERY_MAX_BYTES_BILLED=1073741824
# bigquery_query ツールの既定/上限取得件数
BIGQUERY_DEFAULT_LIMIT=500
BIGQUERY_MAX_LIMIT=2000

# BigQuery 取得 (SELECT) は Google 公式 MCP (MCP Toolbox for Databases) 経由。
# エージェントの bigquery_query/bigquery_schema の裏側で、ローカル起動した
# toolbox を stdio で呼ぶ。toolbox は上の GOOGLE_APPLICATION_CREDENTIALS /
# BIGQUERY_PROJECT を ADC / 対象プロジェクトとして使う。
# toolbox バイナリの入手: https://github.com/googleapis/mcp-toolbox
BIGQUERY_MCP_COMMAND=toolbox
# ハードニング版: SELECT 限定(writeMode: blocked) + データセット限定(allowedDatasets) +
# execute_sql のみ公開 の custom config を読ませる (config/bigquery_toolbox.yaml)。
# project/location/allowedDatasets は上の BIGQUERY_* と一致させること(env補間は非対応)。
# 手早く動かすだけなら prebuilt でも可: --prebuilt bigquery --stdio
BIGQUERY_MCP_ARGS=--config ./config/bigquery_toolbox.yaml --stdio
# prebuilt bigquery の SQL 実行ツール名 (toolbox v1.x は execute_sql)
BIGQUERY_MCP_EXECUTE_TOOL=execute_sql
# サーバー起動 / 1 呼び出しのタイムアウト (秒)
BIGQUERY_MCP_STARTUP_TIMEOUT=30
BIGQUERY_MCP_CALL_TIMEOUT=60
