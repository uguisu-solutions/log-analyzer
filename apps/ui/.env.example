# フロントエンド環境変数（Vite）
#
# ローカル開発では未設定でOK（未設定なら http://localhost:8000 / 認証ヘッダ無し）。
# Vercel などにホスティングする場合のみ設定する。

# バックエンド API の URL（例: Cloud Run のURL）。末尾スラッシュは自動で除去される。
# VITE_API_BASE=https://log-analyzer-xxxxx.a.run.app

# バックエンドの X-API-Key に付与する共有シークレット。
# バックエンド側の環境変数 API_KEY と同じ値を設定すること。
# VITE_API_KEY=change-me-to-a-long-random-secret

# 解析履歴詳細の「解答と比較評価」パネルの表示制御（検証用の内部機能）。
# 未設定（既定）ならマスク（非表示）。本番/デモは未設定のままにする。
# 精度検証で採点機能を使うときだけ "1" を設定してビルド/起動する。
# VITE_SHOW_EVALUATION=1
